# features/gccext/openmp/CMakeLists.txt.in
#
# OpenMP parallel-for demo. -fopenmp must be passed to BOTH compile and link
# (libgomp is only pulled in via the link-side flag). TSan + OpenMP is
# unsupported, so this example is skipped on the TSan job.

gcc_feature_register("@CMAKE_SOURCE_DIR@/features/gccext/openmp/gccext_openmp_parallel_for.cpp")

if(GCC_FEATURE_ANALYZER)
    return()
endif()
if(@GCC_MAJOR@ LESS 13)
    return()
endif()
if("thread" IN_LIST GCC_FEATURE_ACTIVE_SANITIZERS)
    return()
endif()

add_executable(gccext_openmp_parallel_for
    "@CMAKE_SOURCE_DIR@/features/gccext/openmp/gccext_openmp_parallel_for.cpp")
target_compile_options(gccext_openmp_parallel_for PRIVATE
    -std=c++17 @GCC_FEATURE_DEFAULT_COMPILE_TEXT@ @GCC_FEATURE_SAN_COMPILE_TEXT@ @GCC_FEATURE_ANALYZER_COMPILE_TEXT@ -fopenmp)
target_link_options(gccext_openmp_parallel_for PRIVATE
    @GCC_FEATURE_SAN_LINK_TEXT@ -fopenmp)
target_include_directories(gccext_openmp_parallel_for PRIVATE
    "@CMAKE_SOURCE_DIR@/features")
gcc_feature_normal_test(gccext_openmp_parallel_for)
set_tests_properties(gccext_openmp_parallel_for PROPERTIES LABELS gcc-openmp)

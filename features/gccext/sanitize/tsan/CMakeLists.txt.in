# features/gccext/sanitize/tsan/CMakeLists.txt.in
#
# Data-race demo: two threads write the same int with no synchronisation.
# TSan exits 66 when a race is detected; the test asserts that.

gcc_feature_register("@CMAKE_SOURCE_DIR@/features/gccext/sanitize/tsan/gccext_tsan_data_race.cpp")

if(GCC_FEATURE_ANALYZER)
    return()
endif()
if(NOT "thread" IN_LIST GCC_FEATURE_ACTIVE_SANITIZERS)
    return()
endif()
if(@GCC_MAJOR@ LESS 13)
    return()
endif()

add_executable(gccext_tsan_data_race
    "@CMAKE_SOURCE_DIR@/features/gccext/sanitize/tsan/gccext_tsan_data_race.cpp")
target_compile_options(gccext_tsan_data_race PRIVATE
    -std=c++17 @GCC_FEATURE_DEFAULT_COMPILE_TEXT@ @GCC_FEATURE_SAN_COMPILE_TEXT@ @GCC_FEATURE_ANALYZER_COMPILE_TEXT@)
target_link_options(gccext_tsan_data_race PRIVATE
    @GCC_FEATURE_SAN_LINK_TEXT@)
target_include_directories(gccext_tsan_data_race PRIVATE
    "@CMAKE_SOURCE_DIR@/features")
gcc_feature_will_fail_test(gccext_tsan_data_race "data race")
set_tests_properties(gccext_tsan_data_race PROPERTIES LABELS gcc-sanitize)

# features/std/cpp26/CMakeLists.txt.in

gcc_feature_register("@CMAKE_SOURCE_DIR@/features/std/cpp26/cpp26_contracts_basic.cpp")
gcc_feature_register("@CMAKE_SOURCE_DIR@/features/std/cpp26/cpp26_reflection_basic.cpp")
gcc_feature_register("@CMAKE_SOURCE_DIR@/features/std/cpp26/cpp26_saturation_arith.cpp")

if(GCC_FEATURE_ANALYZER)
    return()
endif()

# ---- cpp26_contracts_basic ----
# C++26 contracts are gated behind -fcontracts (off-by-default opt-in). The
# feature is half-landed in current GCC: the .cpp uses the syntax that GCC
# still rejects, so we register a "compile is expected to fail with this
# diagnostic" test instead of a normal build. A passing test means GCC still
# rejects the syntax, which is the documented status today.
if(@GCC_MAJOR@ GREATER_EQUAL 15)
    gcc_feature_expect_compile_error(
        cpp26_contracts_basic
        "@CMAKE_SOURCE_DIR@/features/std/cpp26/cpp26_contracts_basic.cpp"
        STD c++26
        EXTRA_FLAGS -fcontracts
        REGEX "(expected initializer before|value parameter used in a postcondition must be const)"
    )
    set_tests_properties(cpp26_contracts_basic PROPERTIES LABELS "language;experimental")
endif()

# ---- cpp26_reflection_basic ----
# C++26 static reflection (P2996) is gated behind -freflection in GCC 16;
# without the flag the ^^ token / std::meta APIs aren't recognised.
if(@GCC_MAJOR@ GREATER_EQUAL 16)
    add_executable(cpp26_reflection_basic
        "@CMAKE_SOURCE_DIR@/features/std/cpp26/cpp26_reflection_basic.cpp")
    target_compile_options(cpp26_reflection_basic PRIVATE
        -std=c++26 @GCC_FEATURE_DEFAULT_COMPILE_TEXT@ @GCC_FEATURE_SAN_COMPILE_TEXT@ @GCC_FEATURE_ANALYZER_COMPILE_TEXT@ -freflection)
    target_link_options(cpp26_reflection_basic PRIVATE
        @GCC_FEATURE_SAN_LINK_TEXT@)
    target_include_directories(cpp26_reflection_basic PRIVATE
        "@CMAKE_SOURCE_DIR@/features")
    gcc_feature_normal_test(cpp26_reflection_basic)
    set_tests_properties(cpp26_reflection_basic PROPERTIES LABELS templates)
endif()

# ---- cpp26_saturation_arith ----
if(@GCC_MAJOR@ GREATER_EQUAL 14)
    add_executable(cpp26_saturation_arith
        "@CMAKE_SOURCE_DIR@/features/std/cpp26/cpp26_saturation_arith.cpp")
    target_compile_options(cpp26_saturation_arith PRIVATE
        -std=c++26 @GCC_FEATURE_DEFAULT_COMPILE_TEXT@ @GCC_FEATURE_SAN_COMPILE_TEXT@ @GCC_FEATURE_ANALYZER_COMPILE_TEXT@)
    target_link_options(cpp26_saturation_arith PRIVATE
        @GCC_FEATURE_SAN_LINK_TEXT@)
    target_include_directories(cpp26_saturation_arith PRIVATE
        "@CMAKE_SOURCE_DIR@/features")
    gcc_feature_normal_test(cpp26_saturation_arith)
    set_tests_properties(cpp26_saturation_arith PROPERTIES LABELS stl)
endif()

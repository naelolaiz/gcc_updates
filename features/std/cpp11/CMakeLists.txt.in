# features/std/cpp11/CMakeLists.txt.in
#
# Every example here builds the same way (-std=c++11, MIN_GCC 13, no extras),
# differing only in the topic label. The map below pairs each name with its
# topic; the loop afterwards is the actual build recipe.

set(_examples
    # name                          topic
    cpp11_alias_template            templates
    cpp11_alignof_alignas           language
    cpp11_array                     stl
    cpp11_async_future              threading
    cpp11_atomic                    threading
    cpp11_attribute_noreturn        language
    cpp11_auto                      language
    cpp11_bind                      stl
    cpp11_chrono                    stl
    cpp11_condition_variable        threading
    cpp11_constexpr                 language
    cpp11_delete_default            language
    cpp11_explicit_conversion       language
    cpp11_function                  stl
    cpp11_initializer_list          language
    cpp11_inline_namespace          language
    cpp11_lambda                    language
    cpp11_mutex_lock                threading
    cpp11_noexcept                  language
    cpp11_nullptr                   language
    cpp11_override_final            language
    cpp11_random                    stl
    cpp11_range_for                 language
    cpp11_raw_string                language
    cpp11_regex                     stl
    cpp11_rvalue_move               language
    cpp11_scoped_enum               language
    cpp11_smart_ptrs                stl
    cpp11_static_assert             language
    cpp11_thread                    threading
    cpp11_trailing_return           language
    cpp11_tuple                     stl
    cpp11_uniform_init              language
    cpp11_unordered_map             stl
    cpp11_user_defined_literal      language
    cpp11_variadic_templates        templates
)

# Register all sources for the orphan check (always, regardless of build mode).
list(LENGTH _examples _n_total)
math(EXPR _last_idx "${_n_total} - 1")
foreach(_i RANGE 0 ${_last_idx} 2)
    list(GET _examples ${_i} _name)
    gcc_feature_register("@CMAKE_SOURCE_DIR@/features/std/cpp11/${_name}.cpp")
endforeach()

if(GCC_FEATURE_ANALYZER)
    return()
endif()
if(@GCC_MAJOR@ LESS 13)
    return()
endif()

# Build recipe for every example: identical except for the topic label.
foreach(_i RANGE 0 ${_last_idx} 2)
    list(GET _examples ${_i} _name)
    math(EXPR _ti "${_i} + 1")
    list(GET _examples ${_ti} _topic)
    add_executable(${_name} "@CMAKE_SOURCE_DIR@/features/std/cpp11/${_name}.cpp")
    target_compile_options(${_name} PRIVATE
        -std=c++11 @GCC_FEATURE_DEFAULT_COMPILE_TEXT@ @GCC_FEATURE_SAN_COMPILE_TEXT@ @GCC_FEATURE_ANALYZER_COMPILE_TEXT@)
    target_link_options(${_name} PRIVATE
        @GCC_FEATURE_SAN_LINK_TEXT@)
    target_include_directories(${_name} PRIVATE
        "@CMAKE_SOURCE_DIR@/features")
    gcc_feature_normal_test(${_name})
    set_tests_properties(${_name} PROPERTIES LABELS ${_topic})
endforeach()

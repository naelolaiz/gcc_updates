# features/std/cpp20/CMakeLists.txt.in
#
# All examples are -std=c++20. Most need GCC 14+; a couple of long-stable
# ones (cpp20_endian, cpp20_to_address, cpp20_views_keys_values) build at GCC
# 13 too. The data table below pairs each name with its topic and MIN_GCC.

set(_examples
    # name                          topic           min-gcc
    cpp20_atomic_flag_test          threading       14
    cpp20_atomic_ref                threading       14
    cpp20_atomic_shared_ptr         threading       14
    cpp20_atomic_wait               threading       14
    cpp20_barrier                   threading       14
    cpp20_binary_semaphore          threading       14
    cpp20_bit_ops                   stl             14
    cpp20_chrono_calendar           chrono          14
    cpp20_concepts_intro            concepts        14
    cpp20_concepts_requires_expr    concepts        14
    cpp20_consteval                 language        14
    cpp20_coroutine_generator       coroutines      14
    cpp20_counting_semaphore        threading       14
    cpp20_ctad_aggregates           templates       14
    cpp20_ctad_alias                templates       14
    cpp20_designated_init           language        14
    cpp20_endian                    stl             13
    cpp20_erase_if                  stl             14
    cpp20_explicit_bool             templates       14
    cpp20_format                    format          14
    cpp20_jthread                   threading       14
    cpp20_lambdas                   language        14
    cpp20_latch                     threading       14
    cpp20_lerp_midpoint             stl             14
    cpp20_map_contains              stl             14
    cpp20_nttp_class                templates       14
    cpp20_numbers                   stl             14
    cpp20_ranges_algorithms         ranges          14
    cpp20_ranges_views              ranges          14
    cpp20_source_location           stl             14
    cpp20_spaceship                 language        14
    cpp20_span                      stl             14
    cpp20_ssize                     stl             14
    cpp20_stop_token                threading       14
    cpp20_string_starts_ends        stl             14
    cpp20_syncstream                threading       14
    cpp20_to_address                stl             13
    cpp20_views_keys_values         ranges          13
)

list(LENGTH _examples _n_total)
math(EXPR _last_idx "${_n_total} - 1")
foreach(_i RANGE 0 ${_last_idx} 3)
    list(GET _examples ${_i} _name)
    gcc_feature_register("@CMAKE_SOURCE_DIR@/features/std/cpp20/${_name}.cpp")
endforeach()

if(GCC_FEATURE_ANALYZER)
    return()
endif()

foreach(_i RANGE 0 ${_last_idx} 3)
    list(GET _examples ${_i} _name)
    math(EXPR _ti "${_i} + 1")
    list(GET _examples ${_ti} _topic)
    math(EXPR _mi "${_i} + 2")
    list(GET _examples ${_mi} _min_gcc)
    if(@GCC_MAJOR@ LESS ${_min_gcc})
        continue()
    endif()
    add_executable(${_name} "@CMAKE_SOURCE_DIR@/features/std/cpp20/${_name}.cpp")
    target_compile_options(${_name} PRIVATE
        -std=c++20 @GCC_FEATURE_DEFAULT_COMPILE_TEXT@ @GCC_FEATURE_SAN_COMPILE_TEXT@ @GCC_FEATURE_ANALYZER_COMPILE_TEXT@)
    target_link_options(${_name} PRIVATE
        @GCC_FEATURE_SAN_LINK_TEXT@)
    target_include_directories(${_name} PRIVATE
        "@CMAKE_SOURCE_DIR@/features")
    gcc_feature_normal_test(${_name})
    set_tests_properties(${_name} PROPERTIES LABELS ${_topic})
endforeach()
